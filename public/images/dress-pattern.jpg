<svg xmlns='http://www.w3.org/2000/svg' width='1200' height='800' viewBox='0 0 1200 800'>
  <defs>
    <pattern id='p' width='20' height='20' patternUnits='userSpaceOnUse'>
      <rect width='10' height='10' fill='#f8b'/>
      <rect x='10' y='10' width='10' height='10' fill='#bdf'/>
    </pattern>
  </defs>
  <rect width='100%' height='100%' fill='url(#p)'/>
  <text x='50%' y='50%' font-size='48' fill='#333' text-anchor='middle' dominant-baseline='central'>Pattern Dress</text>
</svg>